require "ApocalipseMusic/AMPStation"

-- Copy to common/media/lua/shared/ApocalipseMusic/Songs/<id>.lua AFTER
-- supplying matching sound scripts/assets. This example is not auto-loaded.
ABRRadio.registerSong({
    id = "pack_song01", station = "amp_music",
    title = "Song title", artist = "Artist", duration = 180,
    weight = 10,
    lyricDuration = 4, -- default window when a cue omits untilTime
    -- For ordinary whole-file audio, late listeners wait for the next song.
    sound = "AMP_pack_song01",
    -- Prefer chunks generated by tools/import-song.mjs for mid-song tuning.
    lyrics = {
        -- Sparse cues only: instrumental gaps need no entries. Omit this entire
        -- array for an instrumental song; playback commands remain unchanged.
        { at = 12.5, untilTime = 17.0, text = { EN = "First lyric line", PTBR = "Primeira linha da letra" } },
        { at = 18.0, untilTime = 22.5, text = "Second lyric line" },
    },
})
